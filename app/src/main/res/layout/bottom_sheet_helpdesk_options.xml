<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"

    android:layout_width="match_parent"
    android:layout_height="wrap_content"

    android:orientation="vertical"

    android:padding="20dp">

    <TextView

        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:text="Help Desk"

        android:textStyle="bold"

        android:textSize="20sp"

        android:textColor="#173430"/>

    <Space
        android:layout_width="match_parent"
        android:layout_height="16dp"/>

    <LinearLayout

        android:id="@+id/llRaiseTicket"

        android:layout_width="match_parent"

        android:layout_height="wrap_content"

        android:padding="14dp"

        android:background="?attr/selectableItemBackground"

        android:gravity="center_vertical"

        android:orientation="horizontal">

        <ImageView

            android:layout_width="24dp"

            android:layout_height="24dp"

            android:src="@drawable/ic_ticket"

            android:tint="#173430"/>

        <LinearLayout

            android:layout_width="0dp"

            android:layout_height="wrap_content"

            android:layout_weight="1"

            android:layout_marginStart="16dp"

            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Raise Ticket"
                android:textStyle="bold"
                android:textSize="16sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Create a new support ticket"
                android:textColor="#808080"
                android:textSize="13sp"/>

        </LinearLayout>

    </LinearLayout>

    <LinearLayout

        android:id="@+id/llRequester"

        android:layout_width="match_parent"

        android:layout_height="wrap_content"

        android:layout_marginTop="10dp"

        android:padding="14dp"

        android:background="?attr/selectableItemBackground"

        android:gravity="center_vertical"

        android:orientation="horizontal">

        <ImageView

            android:layout_width="24dp"

            android:layout_height="24dp"

            android:src="@drawable/ic_list"

            android:tint="#173430"/>

        <LinearLayout

            android:layout_width="0dp"

            android:layout_height="wrap_content"

            android:layout_weight="1"

            android:layout_marginStart="16dp"

            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="My Tickets"
                android:textStyle="bold"
                android:textSize="16sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="View and track your tickets"
                android:textColor="#808080"
                android:textSize="13sp"/>

        </LinearLayout>

    </LinearLayout>

    <TextView

        android:id="@+id/tvCancel"

        android:layout_width="match_parent"

        android:layout_height="wrap_content"

        android:layout_marginTop="18dp"

        android:gravity="center"

        android:padding="14dp"

        android:text="Cancel"

        android:textColor="#D32F2F"

        android:textStyle="bold"/>

</LinearLayout>