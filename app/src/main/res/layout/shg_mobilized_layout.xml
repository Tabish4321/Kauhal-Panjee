<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/tvShgMobCons"
        style="@style/editTextHome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="@dimen/dp_15"
        android:elevation="@dimen/dp_5"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">


        <LinearLayout
            android:id="@+id/llTopShgMob"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/color_background_light_grey"
            android:orientation="horizontal"
            android:weightSum="2"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">


            <TextView
                android:id="@+id/tvNew"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.8"
                android:fontFamily="@font/avenir_next_semi_bold"
                android:text="Mobilized by SHG Member"
                android:textColor="@color/color_dark_green"
                android:textSize="@dimen/sp_16" />

            <ImageView
                android:id="@+id/ivShgMobArrow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.2"
                android:layout_marginHorizontal="@dimen/dp_12"
                android:padding="@dimen/dp_4"
                android:src="@drawable/ic_arrow_down" />

        </LinearLayout>

        <View
            android:id="@+id/viewShgMob"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_1"
            android:layout_marginTop="@dimen/dp_8"
            android:background="#F7F7F7"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/llTopShgMob"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Expandable Content -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/expandShgMob"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_12"
            android:visibility="gone"
            android:paddingBottom="12dp"
            app:layout_constraintTop_toBottomOf="@id/viewShgMob"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:id="@+id/llMobilizedShgContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <!-- STATE -->
                <TextView
                    android:id="@+id/tvShgMobState"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/avenir_next_demi_bold"
                    android:padding="@dimen/dp_4"
                    android:text="@string/state"
                    android:textColor="@color/color_dark_green" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/spinnerAutoShgMobState"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/avenir_next_demi_bold"
                    android:hint="@string/select_state"
                    android:padding="1dp"
                    android:textColorHint="@color/color_dark_green"
                    app:boxStrokeColor="@color/color_dark_green">

                    <AutoCompleteTextView
                        android:id="@+id/spinnerShgMobState"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:focusable="false"
                        android:focusableInTouchMode="false"
                        android:inputType="none"
                        android:textColor="@color/color_dark_green"
                        android:textSize="15sp"
                        tools:ignore="LabelFor" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- DISTRICT -->
                <LinearLayout
                    android:id="@+id/llShgMobDistrict"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_12"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/avenir_next_demi_bold"
                        android:padding="@dimen/dp_4"
                        android:text="@string/district"
                        android:textColor="@color/color_dark_green" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/spinnerAutoShgMobDistrict"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/avenir_next_demi_bold"
                        android:hint="@string/select_district"
                        android:padding="1dp"
                        android:textColorHint="@color/color_dark_green"
                        app:boxStrokeColor="@color/color_dark_green">

                        <AutoCompleteTextView
                            android:id="@+id/spinnerShgMobDistrict"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:focusable="false"
                            android:focusableInTouchMode="false"
                            android:inputType="none"
                            android:textColor="@color/color_dark_green"
                            android:textSize="15sp"
                            tools:ignore="LabelFor" />

                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <!-- BLOCK -->
                <LinearLayout
                    android:id="@+id/llShgMobBlock"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_12"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/avenir_next_demi_bold"
                        android:padding="@dimen/dp_4"
                        android:text="@string/Block"
                        android:textColor="@color/color_dark_green" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/avenir_next_demi_bold"
                        android:hint="@string/select_Block"
                        android:padding="1dp"
                        android:textColorHint="@color/color_dark_green"
                        app:boxStrokeColor="@color/color_dark_green">

                        <AutoCompleteTextView
                            android:id="@+id/spinnerShgMobBlock"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:focusable="false"
                            android:focusableInTouchMode="false"
                            android:inputType="none"
                            android:textColor="@color/color_dark_green"
                            android:textSize="15sp"
                            tools:ignore="LabelFor" />

                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <!-- GRAM PANCHAYAT -->
                <LinearLayout
                    android:id="@+id/llShgMobGp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_12"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/avenir_next_demi_bold"
                        android:padding="@dimen/dp_4"
                        android:text="@string/Gp"
                        android:textColor="@color/color_dark_green" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/avenir_next_demi_bold"
                        android:hint="@string/select_gp"
                        android:padding="1dp"
                        android:textColorHint="@color/color_dark_green"
                        app:boxStrokeColor="@color/color_dark_green">

                        <AutoCompleteTextView
                            android:id="@+id/spinnerShgMobGp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:focusable="false"
                            android:focusableInTouchMode="false"
                            android:inputType="none"
                            android:textColor="@color/color_dark_green"
                            android:textSize="15sp"
                            tools:ignore="LabelFor" />

                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>




                <LinearLayout
                    android:id="@+id/llShgMobShg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_12"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/avenir_next_demi_bold"
                        android:padding="@dimen/dp_4"
                        android:text="SHG"
                        android:textColor="@color/color_dark_green" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/avenir_next_demi_bold"
                        android:hint="Select SHG"
                        android:padding="1dp"
                        android:textColorHint="@color/color_dark_green"
                        app:boxStrokeColor="@color/color_dark_green">

                        <AutoCompleteTextView
                            android:id="@+id/spinnerShg"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:focusable="false"
                            android:focusableInTouchMode="false"
                            android:inputType="none"
                            android:textColor="@color/color_dark_green"
                            android:textSize="15sp"
                            tools:ignore="LabelFor" />

                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>


                <!-- SHG MEMBER -->
                <LinearLayout
                    android:id="@+id/llShgMobShgMember"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_12"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/avenir_next_demi_bold"
                        android:padding="@dimen/dp_4"
                        android:text="SHG Member"
                        android:textColor="@color/color_dark_green" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/avenir_next_demi_bold"
                        android:hint="Select SHG Member"
                        android:padding="1dp"
                        android:textColorHint="@color/color_dark_green"
                        app:boxStrokeColor="@color/color_dark_green">

                        <AutoCompleteTextView
                            android:id="@+id/spinnerShgMember"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:focusable="false"
                            android:focusableInTouchMode="false"
                            android:inputType="none"
                            android:textColor="@color/color_dark_green"
                            android:textSize="15sp"
                            tools:ignore="LabelFor" />

                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
                <TextView
                    android:id="@+id/btnShgMobSubmit"
                    style="@style/Button"
                    android:visibility="visible"
                    android:layout_marginTop="@dimen/dp_15"
                    android:drawablePadding="@dimen/dp_20"
                    android:text="@string/submit"
                    app:drawableEndCompat="@drawable/ic_right_arrow" />
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>





</androidx.constraintlayout.widget.ConstraintLayout>