<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="20dp"
    app:cardElevation="10dp"
    android:background="@drawable/img_dialog_background">

    <!-- Title -->
    <TextView
        android:id="@+id/textViewTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:textAppearance="@style/TextAppearance.MaterialComponents.Headline6"
        android:fontFamily="@font/avenir_next_bold"
        android:gravity="center|top"
        android:layout_marginBottom="10dp"/>

    <androidx.cardview.widget.CardView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/buttonClose"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textViewTitle"
        app:cardCornerRadius="12dp"
        app:cardElevation="10dp"
        android:layout_marginBottom="20dp">

        <!-- Container for image and no-image text -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Image View -->
            <ImageView
                android:id="@+id/imageViewPreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:adjustViewBounds="true"
                android:src="@drawable/no_data" />

            <!-- No Image Text (initially hidden) -->
            <TextView
                android:id="@+id/textNoImage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:background="@drawable/no_image_background"
                android:gravity="center"
                android:padding="12dp"
                android:text="No Image Available"
                android:fontFamily="@font/avenir_next_semi_bold"
                android:textColor="@color/black"
                android:textSize="19sp"
                android:visibility="gone" />
        </FrameLayout>

    </androidx.cardview.widget.CardView>
    <!-- Close Button -->
    <Button
        android:id="@+id/buttonClose"
        android:layout_width="150dp"
        android:layout_height="45dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:background="@drawable/button_outline"
        android:textColor="@color/black"
        android:textSize="@dimen/dp_16"
        android:fontFamily="@font/avenir_next_bold"
        android:text="@string/close"/>
</androidx.constraintlayout.widget.ConstraintLayout>