<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.Toolbar xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/universalToolbar"
    android:layout_width="match_parent"
    android:layout_height="100dp"
    android:background="@drawable/nav_header_gradient"
    android:elevation="8dp"
    app:contentInsetStart="0dp"
    >

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="12dp"
        android:paddingEnd="16dp">

        <!-- Back Button - Modern ripple + larger tap area -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBack"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:icon="@drawable/back_arrow"
            app:iconTint="@color/white"
            app:iconSize="24dp"
            app:backgroundTint="@android:color/transparent"
            app:cornerRadius="24dp"
            app:rippleColor="@color/white"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- DDU-GKY Logo - Slightly bigger & rounded -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/logo_img"
            android:layout_width="160dp"
            android:layout_height="64dp"
            android:src="@drawable/ddy_logo"
            android:scaleType="fitCenter"
            android:elevation="6dp"
            android:padding="8dp"
            android:background="@color/white_brilliant"
            app:shapeAppearanceOverlay="@style/RoundedTopCorners"
            app:layout_constraintStart_toEndOf="@id/btnBack"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintHorizontal_bias="0"
            android:layout_marginStart="8dp"
            android:visibility="gone" />

        <!-- Screen Title - Modern bold with subtle shadow -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Screen Title"
            android:textColor="@color/white"
            android:textSize="21sp"
            android:textStyle="bold"
            android:fontFamily="@font/avenir_next_demi_bold"
            android:ellipsize="end"
            android:maxLines="2"
            android:shadowColor="#80000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="4"
            android:layout_marginStart="12dp"
            app:layout_constraintStart_toEndOf="@id/btnBack"
            app:layout_constraintEnd_toStartOf="@id/changeLanguage"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintHorizontal_bias="0" />

        <!-- Language Toggle - Modern floating style -->
        <!--        <com.google.android.material.button.MaterialButton-->
        <!--            android:id="@+id/changeLanguage"-->
        <!--            android:layout_width="44dp"-->
        <!--            android:layout_height="44dp"-->
        <!--            app:icon="@drawable/ic_lang_toggle"-->
        <!--            app:cornerRadius="22dp"-->
        <!--            app:layout_constraintEnd_toStartOf="@id/profilePic"-->
        <!--            app:layout_constraintTop_toTopOf="parent"-->
        <!--            app:layout_constraintBottom_toBottomOf="parent"-->
        <!--            android:layout_marginEnd="8dp"-->
        <!--            android:visibility="" />-->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/changeLanguage"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:src="@drawable/ic_lang_toggle"
            app:shapeAppearanceOverlay="@style/CircleImageView"
            app:strokeColor="@color/white"
            app:strokeWidth="2.5dp"
            app:layout_constraintEnd_toStartOf="@id/profilePic"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginEnd="8dp"
            android:scaleType="fitCenter"
            android:elevation="6dp"
            android:padding="8dp"
            android:background="@color/white_brilliant"
            android:visibility="gone" />

        <!-- Profile Pic - Circle with border -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/profilePic"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:src="@drawable/ic_user_avatar"
            app:shapeAppearanceOverlay="@style/CircleImageView"
            app:strokeColor="@color/white"
            app:strokeWidth="2.5dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginEnd="8dp"
            android:scaleType="fitCenter"
            android:elevation="6dp"
            android:padding="8dp"
            android:background="@color/white_brilliant"
            android:visibility="gone" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.appcompat.widget.Toolbar>